# ==========================================================================
# Bhopal CivicAI — backend environment
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ==========================================================================

# --------------------------------------------------------------------------
# Application
# --------------------------------------------------------------------------
APP_NAME="Bhopal-flow"
APP_ENV=development                  # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --------------------------------------------------------------------------
# Database (Supabase Postgres)
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# Use the *pooler* (port 6543) connection string for serverless deployments.
# Note the `+psycopg` driver suffix and URL-encoded password.
# --------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Create tables on boot. Keep true for local dev; use the SQL migration
# (migrations/001_init.sql) in production and set this to false.
AUTO_CREATE_TABLES=true
SEED_DEPARTMENTS=true

# --------------------------------------------------------------------------
# Supabase Auth — JWT verification
# Pick ONE of the two verification modes.
#
# Mode A (legacy / shared secret): set SUPABASE_JWT_SECRET.
#   Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
# Mode B (asymmetric signing keys, recommended): leave the secret blank and
#   set SUPABASE_URL. Keys are fetched + cached from
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# --------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>          # safe for the React frontend
SUPABASE_SERVICE_ROLE_KEY=                   # optional, backend-only, never expose
SUPABASE_JWT_SECRET=<jwt-secret-or-blank>
SUPABASE_JWT_ALGORITHMS=HS256                # HS256 | ES256 | RS256 (comma-separated ok)
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=                         # optional; defaults to {SUPABASE_URL}/auth/v1

# --------------------------------------------------------------------------
# Claude API — KEEP THIS KEY IN THE BACKEND ONLY.
# Never ship it to the React app or any client bundle.
# --------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium                 # low | medium | high | xhigh | max
CLAUDE_MAX_TOKENS=8000
CLAUDE_TIMEOUT_SECONDS=120
AI_ENABLED=true                      # false -> deterministic fallback analyser only

# --------------------------------------------------------------------------
# Roles / admin provisioning
# Admins can NEVER be created through normal signup. A profile is granted the
# admin role only if its email is listed here, or by an existing admin via
# POST /api/v1/admin/users/{user_id}/role, or by scripts/create_admin.py.
# --------------------------------------------------------------------------
ADMIN_EMAILS=admin@bhopalcivicai.in
ADMIN_BOOTSTRAP_SECRET=              # optional shared secret for scripts/create_admin.py

# --------------------------------------------------------------------------
# CORS — React frontend origins (comma-separated, no trailing slash)
# --------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------------------------
# Civic / geo tuning
# --------------------------------------------------------------------------
CITY_NAME=Bhopal
CITY_CENTER_LAT=23.2599
CITY_CENTER_LON=77.4126
CITY_RADIUS_KM=40                    # complaints outside this are rejected
DUPLICATE_RADIUS_METERS=150          # candidate window for duplicate detection
NEARBY_RADIUS_METERS=500             # "confirm existing nearby issue" window
HOTSPOT_GRID_METERS=500              # hotspot cluster cell size
HOTSPOT_MIN_COMPLAINTS=3             # min complaints for a cell to be a hotspot

# --------------------------------------------------------------------------
# Rate limiting (in-process; put a real gateway limiter in front in prod)
# --------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120              # requests per window per client
RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_REQUESTS=10            # stricter window for AI endpoints
